# Copy this file to .env and fill in the keys (.env stays on this Mac, never shared).
# Without keys, T3 runs in mock mode: the whole experience works with stand-in AI.

# Claude (questions, yes/no, object + haiku) — console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (speech-to-text) — platform.openai.com/api-keys
OPENAI_API_KEY=

# fal.ai (image, 3D) — fal.ai/dashboard/keys
FAL_KEY=

# Mock mode options (for testing without keys)
# MOCK_YESNO=yes        # yes | no | unclear: which answer the mock "hears"
# MOCK_FAST=1           # skip the pretend thinking time

# Server port (the demo uses 8443, so both can run side by side)
# T3_PORT=8444

# Haiku style: strict (5-7-5 checked, season word, cut) or free (haiku-inspired)
# T3_HAIKU=strict
